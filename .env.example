# Local development defaults. Copy this file to .env; never put real secrets here.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TIMEZONE=Asia/Jakarta
APP_ORIGIN=http://localhost:5173
# Optional identifier exposed as X-App-Version by GET /api/v1/health.
# Leave unset locally; deployments should inject the immutable deployed commit ID.
# APP_VERSION=

# Local-only Compose database. Keep the password URL-safe (random hex is convenient).
POSTGRES_PASSWORD=
# Set DATABASE_URL to the same password; the demo seeder only accepts this local target:
# postgresql://absen_local:<POSTGRES_PASSWORD>@127.0.0.1:5433/absen_local_demo?schema=public
DATABASE_URL=

# Demo accounts are created only when explicitly opted in. Use separate strong local-only values.
SEED_DEMO_DATA=false
DEMO_ADMIN_1_PASSWORD=
DEMO_ADMIN_2_PASSWORD=
DEMO_SUPERVISOR_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=

# Optional outside production. Production requires a strong SESSION_SECRET and HTTPS APP_ORIGIN.
SESSION_SECRET=

# Company-approved legal content must be configured together. Consent routes return 503 if absent.
CONSENT_POLICY_VERSION=
CONSENT_POLICY_TEXT=

# Leave all storage values blank until a provider is configured.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Provider remains undecided. Credentials are opaque provider-specific data.
NOTIFICATION_PROVIDER=
NOTIFICATION_CREDENTIALS=

# PRD default: retain selfie evidence for 12 months.
SELFIE_RETENTION_MONTHS=12
SELFIE_UPLOAD_URL_TTL_SECONDS=120

# JSON object of feature-name to boolean overrides.
FEATURE_FLAGS={}
