Employee --> UC3
Employee --> UC4
Employee --> UC5
Employee --> UC6
Employee --> UC7
HR --> UC1
HR --> UC2
HR --> UC8
HR --> UC9
HR --> UC10
HR --> UC11
HR --> UC12
HR --> UC13
HR --> UC14
Manager --> UC1
