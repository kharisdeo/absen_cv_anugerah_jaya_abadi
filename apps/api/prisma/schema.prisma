  isActive               Boolean  @default(true) @map("is_active")
  createdByUserAccountId String   @map("created_by_user_account_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  store   Store?      @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator UserAccount @relation("SystemDisruptionCreator", fields: [createdByUserAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([storeId, isActive, startsAt, endsAt], map: "system_disruptions_store_active_period_idx")
  @@map("system_disruptions")
}

model MonthlyRecap {
  id                      String      @id @default(uuid()) @db.Uuid
  employeeId              String      @map("employee_id") @db.Uuid
  storeId                 String?     @map("store_id") @db.Uuid
  periodStart             DateTime    @map("period_start") @db.Date
  status                  RecapStatus @default(OPEN)
  workDays                Int         @default(0) @map("work_days")
  presentDays             Int         @default(0) @map("present_days")
  lateDays                Int         @default(0) @map("late_days")
  lateMinutes             Int         @default(0) @map("late_minutes")
  absentDays              Int         @default(0) @map("absent_days")
  leaveDays               Int         @default(0) @map("leave_days")
  sickDays                Int         @default(0) @map("sick_days")
  annualLeaveDays         Int         @default(0) @map("annual_leave_days")
  totalWorkMinutes        Int         @default(0) @map("total_work_minutes")
  approvedOvertimeMinutes Int         @default(0) @map("approved_overtime_minutes")
  snapshot                Json?
  closedByUserAccountId   String?     @map("closed_by_user_account_id") @db.Uuid
  closedAt                DateTime?   @map("closed_at") @db.Timestamptz(3)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store    Store?       @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  closer   UserAccount? @relation("MonthlyRecapCloser", fields: [closedByUserAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, periodStart, storeId], map: "monthly_recaps_employee_period_store_key")
  @@index([periodStart, status, storeId], map: "monthly_recaps_period_status_store_idx")
  @@map("monthly_recaps")
}

model Notification {
